{
    "name": "@ismailnakkar/ui-behaviours",
    "version": "0.7.1",
    "description": "Page behaviours from plain HTML attributes (copy with a spoken result, confirm, submit once or on a change, native dialogs, steps, show by a radio, checkbox or select, check all, autoselect, dismiss a banner, light-dismiss a details menu), a Laravel-ready post(), and a date range picker over Cally with an optional stylesheet.",
    "keywords": [
        "clipboard",
        "dialog",
        "confirm",
        "date-range",
        "cally",
        "data-attributes",
        "stepper",
        "dropdown",
        "dismiss",
        "fetch",
        "laravel"
    ],
    "homepage": "https://github.com/ismailnakkar/ui-behaviours",
    "bugs": {
        "url": "https://github.com/ismailnakkar/ui-behaviours/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ismailnakkar/ui-behaviours.git"
    },
    "license": "MIT",
    "author": {
        "name": "Ismail Nakkar",
        "email": "juge.steam@gmail.com"
    },
    "type": "module",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./range-picker": {
            "types": "./src/range-picker.d.ts",
            "default": "./src/range-picker.js"
        },
        "./range-picker.css": {
            "types": "./src/range-picker.d.css.ts",
            "default": "./src/range-picker.css"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": [
        "./src/range-picker.js",
        "./src/range-picker.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "oxlint --deny-warnings && vitest run",
        "prepublishOnly": "npm test"
    },
    "peerDependencies": {
        "cally": "^0.9.2"
    },
    "peerDependenciesMeta": {
        "cally": {
            "optional": true
        }
    },
    "devDependencies": {
        "cally": "^0.9.2",
        "happy-dom": "^21.0.4",
        "oxlint": "^1.95.0",
        "vitest": "^5.1.0"
    }
}
